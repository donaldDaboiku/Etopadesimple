rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// organisations/{orgId}
//   Grace Fellowship stays organisations/grace (name only).
//   A new church is a new id, never organisations/grace, and stores:
//   name: string (2-120)
//   adminEmail: auth email
//   creatorUid: auth uid
//   claimed: true, set in the same transaction as the first member
//
// organisations/{orgId}/members/{lowercaseEmail}
//   The public create path may add only the admin email, role church_admin,
//   uid == auth.uid, pastorId null, status active. getAfter(claimed) blocks a second member.
//   Later members are admin invites: pastor, assistant_pastor, secretary, church_admin.
//   super_admin cannot be created here.
//
// directory/{lowercaseEmail}
//   organisationId: the new church id. Not used for grace. No updates.
//
// Subcollections below exist on every organisations/{orgId}. Grace is the original church.
//
// organisations/{orgId}/pastors/{pastorId}
//   name: string (2-120)
//   active: bool
//   Public read is required by the booking form.
//
// organisations/grace/slotHolds/{pastorId_date_slot}
//   pastorId, date (YYYY-MM-DD), slot (HH:MM), status, bookingId
//   Public read is required so taken times show without visitor details.
//
// organisations/grace/bookings/{bookingId}
//   pastorId, appointmentTypeId, visitorName, visitorEmail, visitorPhone,
//   contactMethod, meetingMode, date, slot, scheduledFor, status, notes,
//   bookingReference, createdAt, holdId
//   A pastor confirms or declines only a booking with their own pastorId.
//   A secretary of this organisation confirms or declines any booking in it.
//
// organisations/grace/members/{lowercaseEmail}
//   email, name, role, pastorId, uid, status
//
// organisations/grace/availability/{pastorId}
//   weekdays: list of 0-6 (Sunday-Saturday), slots: catalog times, blockedDates
//   Public read is required so the booking calendar can hide closed days.
//
// organisations/grace/notices/{bookingId_scope_kind}
//   scope pastor|office, pastorId, bookingId, kind, visitorName, date, slot, createdAt
//   A pastor reads only notices for their pastorId. Office reads scope office.
//   Visitor email is not stored here.
//
// organisations/grace/noticeReads/{email__noticeId}
//   email, noticeId. The signed-in person creates only their own dismissals.
//
// organisations/grace/audits/{bookingId_action}
//   bookingId, pastorId, action requested|confirmed|declined, actor, visitorName,
//   bookingReference, createdAt. Visitor email is not stored.
//   A pastor reads rows for their pastorId. Office reads every row.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email is string;
    }

    function emailId() {
      return request.auth.token.email.lower();
    }

    function isOrgId(orgId) {
      return orgId is string
        && orgId.size() >= 2
        && orgId.size() <= 64
        && orgId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function orgPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId);
    }

    function memberPath(orgId) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(emailId());
    }

    function memberDoc(orgId, emailKey) {
      return /databases/$(database)/documents/organisations/$(orgId)/members/$(emailKey);
    }

    function directoryPath(emailKey) {
      return /databases/$(database)/documents/directory/$(emailKey);
    }

    function memberData(orgId) {
      return get(memberPath(orgId)).data;
    }

    function staffRecord(orgId) {
      let member = memberData(orgId);
      return member.status == 'active' && member.email == emailId();
    }

    function isStaff(orgId) {
      return isAuthenticated() && exists(memberPath(orgId)) && staffRecord(orgId);
    }

    function isAdmin(orgId) {
      return isAuthenticated() && exists(memberPath(orgId)) && adminRecord(orgId);
    }

    function adminRecord(orgId) {
      let member = memberData(orgId);
      return member.status == 'active'
        && member.email == emailId()
        && member.role in ['church_admin', 'super_admin'];
    }

    function isOffice(orgId) {
      return isAuthenticated() && exists(memberPath(orgId)) && officeRecord(orgId);
    }

    function officeRecord(orgId) {
      let member = memberData(orgId);
      return member.status == 'active'
        && member.email == emailId()
        && member.role in ['church_admin', 'super_admin', 'secretary'];
    }

    function isSecretary(orgId) {
      return isAuthenticated() && exists(memberPath(orgId)) && secretaryRecord(orgId);
    }

    function secretaryRecord(orgId) {
      let member = memberData(orgId);
      return member.status == 'active'
        && member.email == emailId()
        && member.role == 'secretary';
    }

    function isPastorAccount(orgId) {
      return isAuthenticated() && exists(memberPath(orgId)) && pastorRecord(orgId);
    }

    function pastorRecord(orgId) {
      let member = memberData(orgId);
      return member.status == 'active'
        && member.email == emailId()
        && member.role in ['pastor', 'assistant_pastor'];
    }

    // Grace is the only place a super_admin member can exist. Signup cannot create one.
    function isPlatformAdmin() {
      return isAuthenticated() && exists(memberPath('grace')) && platformRecord();
    }

    function platformRecord() {
      let member = memberData('grace');
      return member.status == 'active'
        && member.email == emailId()
        && member.role == 'super_admin';
    }

    function managesChurch(orgId) {
      return isAdmin(orgId) || isPlatformAdmin();
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isValidEmail(email) {
      return email is string && email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') && email.size() <= 254;
    }

    function validName(value) {
      return value is string && value.size() >= 2 && value.size() <= 120;
    }

    function pastorPath(orgId, pastorId) {
      return /databases/$(database)/documents/organisations/$(orgId)/pastors/$(pastorId);
    }

    function holdPath(orgId, holdId) {
      return /databases/$(database)/documents/organisations/$(orgId)/slotHolds/$(holdId);
    }

    function holdMatchesBooking(orgId, holdId) {
      return resource.data.bookingId is string
        && exists(bookingPath(orgId, resource.data.bookingId))
        && get(bookingPath(orgId, resource.data.bookingId)).data.holdId == holdId
        && get(bookingPath(orgId, resource.data.bookingId)).data.pastorId == resource.data.pastorId;
    }

    function canRenameOwnProfile(orgId, emailKey) {
      return isAuthenticated()
        && emailKey == emailId()
        && resource.data.status == 'active'
        && resource.data.uid == request.auth.uid
        && resource.data.email == emailId()
        && resource.data.role in ['pastor', 'assistant_pastor']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validName(request.resource.data.name)
        && isValidMember(orgId, request.resource.data, emailKey);
    }

    function bookingPath(orgId, bookingId) {
      return /databases/$(database)/documents/organisations/$(orgId)/bookings/$(bookingId);
    }

    function noticePath(orgId, noticeId) {
      return /databases/$(database)/documents/organisations/$(orgId)/notices/$(noticeId);
    }

    function isValidAudit(data) {
      return data.keys().hasOnly(['bookingId', 'pastorId', 'action', 'actor', 'visitorName', 'bookingReference', 'createdAt'])
        && data.bookingId is string
        && data.bookingId.size() >= 8
        && data.pastorId is string
        && data.action in ['requested', 'confirmed', 'declined']
        && data.actor is string
        && data.actor.size() >= 2
        && data.actor.size() <= 254
        && validName(data.visitorName)
        && data.bookingReference is string
        && data.bookingReference.matches('^[A-F0-9]{12}$')
        && data.createdAt == request.time;
    }

    function canReadNotice(orgId, data) {
      return (isOffice(orgId) && data.scope == 'office')
        || (isPastorAccount(orgId) && data.pastorId == memberData(orgId).pastorId)
        || (isPlatformAdmin() && data.scope == 'office');
    }

    function isValidNotice(data) {
      return data.keys().hasOnly(['scope', 'pastorId', 'bookingId', 'kind', 'visitorName', 'date', 'slot', 'createdAt'])
        && data.scope in ['pastor', 'office']
        && data.kind in ['requested', 'confirmed', 'declined']
        && data.bookingId is string
        && data.bookingId.size() >= 8
        && validName(data.visitorName)
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.slot in ['09:00', '09:30', '10:15', '11:00', '13:30', '15:00', '15:45']
        && data.createdAt == request.time
        && (
          (data.scope == 'pastor' && data.pastorId is string)
          || (data.scope == 'office' && data.pastorId == null)
        );
    }

    function availabilityPath(orgId, pastorId) {
      return /databases/$(database)/documents/organisations/$(orgId)/availability/$(pastorId);
    }

    function weekdayIndex(date) {
      let parts = date.split('-');
      return timestamp.date(int(parts[0]), int(parts[1]), int(parts[2])).dayOfWeek() - 1;
    }

    function slotFitsSchedule(orgId, data) {
      return !exists(availabilityPath(orgId, data.pastorId))
        || (
          data.slot in get(availabilityPath(orgId, data.pastorId)).data.slots
          && !(data.date in get(availabilityPath(orgId, data.pastorId)).data.blockedDates)
          && get(availabilityPath(orgId, data.pastorId)).data.weekdays.hasAny([weekdayIndex(data.date)])
        );
    }

    function isValidSchedule(data) {
      return data.keys().hasOnly(['weekdays', 'slots', 'blockedDates'])
        && data.weekdays is list
        && data.weekdays.size() > 0
        && data.weekdays.size() <= 7
        && data.weekdays.hasOnly([0, 1, 2, 3, 4, 5, 6])
        && data.slots is list
        && data.slots.size() > 0
        && data.slots.size() <= 7
        && data.slots.hasOnly(['09:00', '09:30', '10:15', '11:00', '13:30', '15:00', '15:45'])
        && data.blockedDates is list
        && data.blockedDates.size() <= 90
        && (
          data.blockedDates.size() == 0
          || data.blockedDates.join(',').matches('^\\d{4}-\\d{2}-\\d{2}(,\\d{4}-\\d{2}-\\d{2})*$')
        );
    }

    function isValidPastor(data) {
      return hasOnlyAllowedFields(['name', 'active'])
        && validName(data.name)
        && data.active is bool;
    }

    function isValidHold(orgId, data) {
      return data.keys().hasOnly(['pastorId', 'date', 'slot', 'status', 'bookingId'])
        && data.pastorId is string
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.slot in ['09:00', '09:30', '10:15', '11:00', '13:30', '15:00', '15:45']
        && data.status in ['pending', 'confirmed']
        && data.bookingId is string
        && data.bookingId.size() >= 8
        && exists(pastorPath(orgId, data.pastorId))
        && get(pastorPath(orgId, data.pastorId)).data.active == true;
    }

    function isValidBooking(data) {
      return data.keys().hasOnly([
        'pastorId', 'appointmentTypeId', 'visitorName', 'visitorEmail', 'visitorPhone',
        'contactMethod', 'meetingMode', 'date', 'slot', 'scheduledFor', 'status', 'notes',
        'bookingReference', 'createdAt', 'holdId'
      ])
        && data.pastorId is string
        && data.appointmentTypeId is string
        && data.appointmentTypeId.size() == 36
        && validName(data.visitorName)
        && isValidEmail(data.visitorEmail)
        && data.contactMethod in ['email', 'whatsapp', 'sms']
        && data.meetingMode in ['physical', 'virtual']
        && data.date is string
        && data.date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.slot in ['09:00', '09:30', '10:15', '11:00', '13:30', '15:00', '15:45']
        && data.scheduledFor is timestamp
        && data.status in ['pending', 'confirmed', 'declined']
        && (data.notes == null || (data.notes is string && data.notes.size() <= 1000))
        && (
          (data.contactMethod == 'email' && (data.visitorPhone == null || (data.visitorPhone is string && data.visitorPhone.size() <= 40)))
          || (data.contactMethod in ['whatsapp', 'sms'] && data.visitorPhone is string && data.visitorPhone.size() >= 7 && data.visitorPhone.size() <= 40)
        )
        && data.bookingReference is string
        && data.bookingReference.matches('^[A-F0-9]{12}$')
        && data.createdAt is timestamp
        && data.holdId == data.pastorId + '_' + data.date + '_' + data.slot.replace(':', '-');
    }

    function isValidMember(orgId, data, emailKey) {
      return data.keys().hasOnly(['email', 'name', 'role', 'pastorId', 'uid', 'status'])
        && data.email == emailKey
        && isValidEmail(data.email)
        && validName(data.name)
        && data.role in ['super_admin', 'church_admin', 'pastor', 'assistant_pastor', 'secretary', 'read_only_staff']
        && (
          (data.role in ['pastor', 'assistant_pastor'] && data.pastorId is string && exists(pastorPath(orgId, data.pastorId)))
          || (!(data.role in ['pastor', 'assistant_pastor']) && data.pastorId == null)
        )
        && (
          (data.status == 'invited' && data.uid == null)
          || (data.status == 'active' && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128)
        );
    }

    function isValidOrganisation(data) {
      return data.keys().hasOnly(['name', 'adminEmail', 'creatorUid', 'claimed'])
        && validName(data.name)
        && isValidEmail(data.adminEmail)
        && data.adminEmail == emailId()
        && data.creatorUid is string
        && data.creatorUid == request.auth.uid
        && data.creatorUid.size() <= 128
        && data.claimed == true;
    }

    function createdChurchMatches(orgId) {
      let member = getAfter(memberDoc(orgId, emailId())).data;
      let directory = getAfter(directoryPath(emailId())).data;
      return member.keys().hasOnly(['email', 'name', 'role', 'pastorId', 'uid', 'status'])
        && member.role == 'church_admin'
        && member.email == emailId()
        && member.uid == request.auth.uid
        && member.status == 'active'
        && member.pastorId == null
        && directory.keys().hasOnly(['organisationId'])
        && directory.organisationId == orgId;
    }

    function canCreateOrganisation(orgId) {
      return isAuthenticated()
        && orgId != 'grace'
        && isOrgId(orgId)
        && isValidOrganisation(request.resource.data)
        && !exists(directoryPath(emailId()))
        && createdChurchMatches(orgId);
    }

    function isBootstrapAdmin(orgId, emailKey) {
      return isAuthenticated()
        && orgId != 'grace'
        && isOrgId(orgId)
        && emailKey == emailId()
        && !exists(orgPath(orgId))
        && bootstrapOrgFields(orgId)
        && isValidMember(orgId, request.resource.data, emailKey)
        && request.resource.data.role == 'church_admin'
        && request.resource.data.status == 'active'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.pastorId == null
        && request.resource.data.email == emailId();
    }

    function bootstrapOrgFields(orgId) {
      let org = getAfter(orgPath(orgId)).data;
      return org.claimed == true
        && org.adminEmail == emailId()
        && org.creatorUid == request.auth.uid
        && org.keys().hasOnly(['name', 'adminEmail', 'creatorUid', 'claimed']);
    }

    function ownChurchMatches(orgId) {
      let org = getAfter(orgPath(orgId)).data;
      let member = getAfter(memberDoc(orgId, emailId())).data;
      return org.claimed == true
        && org.adminEmail == emailId()
        && org.creatorUid == request.auth.uid
        && member.role == 'church_admin'
        && member.uid == request.auth.uid
        && member.email == emailId()
        && member.status == 'active';
    }

    function canPointOwnChurch(emailKey, orgId) {
      return emailKey == emailId()
        && !exists(orgPath(orgId))
        && ownChurchMatches(orgId);
    }

    function invitedMemberMatches(orgId, emailKey) {
      let member = getAfter(memberDoc(orgId, emailKey)).data;
      return member.email == emailKey
        && member.status == 'invited'
        && member.uid == null
        && member.role in ['pastor', 'assistant_pastor', 'secretary', 'church_admin'];
    }

    function canPointInvite(emailKey, orgId) {
      return emailKey != emailId()
        && isValidEmail(emailKey)
        && managesChurch(orgId)
        && invitedMemberMatches(orgId, emailKey);
    }

    function canCreateDirectory(emailKey) {
      return isAuthenticated()
        && request.resource.data.keys().hasOnly(['organisationId'])
        && request.resource.data.organisationId is string
        && isOrgId(request.resource.data.organisationId)
        && request.resource.data.organisationId != 'grace'
        && (
          canPointOwnChurch(emailKey, request.resource.data.organisationId)
          || canPointInvite(emailKey, request.resource.data.organisationId)
        );
    }

    match /organisations/{orgId} {
      allow get: if isStaff(orgId) || isPlatformAdmin();
      allow list: if isPlatformAdmin();
      allow create: if canCreateOrganisation(orgId);
      allow update, delete: if false;

      match /availability/{pastorId} {
        allow read: if true;
        allow create, update: if isValidSchedule(request.resource.data)
          && exists(pastorPath(orgId, pastorId))
          && (
            (isPastorAccount(orgId) && memberData(orgId).pastorId == pastorId)
            || isAdmin(orgId)
            || isPlatformAdmin()
          );
        allow delete: if false;
      }

      match /pastors/{pastorId} {
        allow read: if true;
        allow create: if managesChurch(orgId) && isValidPastor(request.resource.data) && request.resource.data.active == true;
        allow update, delete: if false;
      }

      match /slotHolds/{holdId} {
        allow read: if true;
        allow create: if isValidHold(orgId, request.resource.data)
          && request.resource.data.status == 'pending'
          && holdId == request.resource.data.pastorId + '_' + request.resource.data.date + '_' + request.resource.data.slot.replace(':', '-');
        allow update: if resource.data.status == 'pending'
          && request.resource.data.status == 'confirmed'
          && isValidHold(orgId, request.resource.data)
          && areImmutableFieldsUnchanged(['pastorId', 'date', 'slot', 'bookingId'])
          && holdMatchesBooking(orgId, holdId)
          && get(bookingPath(orgId, resource.data.bookingId)).data.status == 'confirmed'
          && (
            (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
            || isSecretary(orgId)
          );
        allow delete: if (
            holdMatchesBooking(orgId, holdId)
            && get(bookingPath(orgId, resource.data.bookingId)).data.status == 'declined'
            && (
              (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
              || isSecretary(orgId)
              || isAdmin(orgId)
              || isPlatformAdmin()
            )
          )
          || (
            resource.data.bookingId is string
            && !exists(bookingPath(orgId, resource.data.bookingId))
            && (
              (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
              || isSecretary(orgId)
              || isAdmin(orgId)
              || isPlatformAdmin()
            )
          );
      }

      match /bookings/{bookingId} {
        allow read: if isOffice(orgId)
          || (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
          || isPlatformAdmin();
        allow create: if isValidBooking(request.resource.data)
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time
          && request.resource.data.scheduledFor > request.time + duration.value(30, 'm')
          && request.resource.data.scheduledFor < request.time + duration.value(90, 'd')
          && exists(pastorPath(orgId, request.resource.data.pastorId))
          && get(pastorPath(orgId, request.resource.data.pastorId)).data.active == true
          && exists(holdPath(orgId, request.resource.data.holdId))
          && get(holdPath(orgId, request.resource.data.holdId)).data.bookingId == bookingId
          && get(holdPath(orgId, request.resource.data.holdId)).data.pastorId == request.resource.data.pastorId
          && slotFitsSchedule(orgId, request.resource.data);
        allow update: if (
            (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
            || isSecretary(orgId)
          )
          && resource.data.status == 'pending'
          && request.resource.data.status in ['confirmed', 'declined']
          && isValidBooking(request.resource.data)
          && areImmutableFieldsUnchanged([
            'pastorId', 'appointmentTypeId', 'visitorName', 'visitorEmail', 'visitorPhone',
            'contactMethod', 'meetingMode', 'date', 'slot', 'scheduledFor', 'notes',
            'bookingReference', 'createdAt', 'holdId'
          ]);
        allow delete: if false;
      }

      match /notices/{noticeId} {
        allow read: if canReadNotice(orgId, resource.data);
        allow create: if isValidNotice(request.resource.data)
          && noticeId == request.resource.data.bookingId + '_' + request.resource.data.scope + '_' + request.resource.data.kind
          && exists(bookingPath(orgId, request.resource.data.bookingId))
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.visitorName == request.resource.data.visitorName
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.date == request.resource.data.date
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.slot == request.resource.data.slot
          && (
            request.resource.data.scope == 'office'
            || get(bookingPath(orgId, request.resource.data.bookingId)).data.pastorId == request.resource.data.pastorId
          )
          && (
            (
              request.resource.data.kind == 'requested'
              && get(bookingPath(orgId, request.resource.data.bookingId)).data.status == 'pending'
            )
            || (
              request.resource.data.kind in ['confirmed', 'declined']
              && get(bookingPath(orgId, request.resource.data.bookingId)).data.status == request.resource.data.kind
              && (
                (isPastorAccount(orgId) && memberData(orgId).pastorId == get(bookingPath(orgId, request.resource.data.bookingId)).data.pastorId)
                || isSecretary(orgId)
              )
            )
          );
        allow update, delete: if false;
      }

      match /noticeReads/{readId} {
        allow read: if isStaff(orgId) && resource.data.email == emailId();
        allow create: if isStaff(orgId)
          && request.resource.data.keys().hasOnly(['email', 'noticeId'])
          && request.resource.data.email == emailId()
          && request.resource.data.noticeId is string
          && request.resource.data.noticeId.size() <= 180
          && readId == emailId() + '__' + request.resource.data.noticeId
          && exists(noticePath(orgId, request.resource.data.noticeId))
          && canReadNotice(orgId, get(noticePath(orgId, request.resource.data.noticeId)).data);
        allow update, delete: if false;
      }

      match /audits/{auditId} {
        allow read: if isOffice(orgId)
          || (isPastorAccount(orgId) && resource.data.pastorId == memberData(orgId).pastorId)
          || isPlatformAdmin();
        allow create: if isValidAudit(request.resource.data)
          && auditId == request.resource.data.bookingId + '_' + request.resource.data.action
          && exists(bookingPath(orgId, request.resource.data.bookingId))
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.pastorId == request.resource.data.pastorId
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.visitorName == request.resource.data.visitorName
          && get(bookingPath(orgId, request.resource.data.bookingId)).data.bookingReference == request.resource.data.bookingReference
          && (
            (
              request.resource.data.action == 'requested'
              && request.resource.data.actor == 'visitor'
              && get(bookingPath(orgId, request.resource.data.bookingId)).data.status == 'pending'
            )
            || (
              request.resource.data.action in ['confirmed', 'declined']
              && get(bookingPath(orgId, request.resource.data.bookingId)).data.status == request.resource.data.action
              && request.resource.data.actor == emailId()
              && (
                (isPastorAccount(orgId) && memberData(orgId).pastorId == get(bookingPath(orgId, request.resource.data.bookingId)).data.pastorId)
                || isSecretary(orgId)
              )
            )
          );
        allow update, delete: if false;
      }

      match /members/{emailKey} {
        allow read: if isAdmin(orgId) || (isAuthenticated() && emailKey == emailId()) || isPlatformAdmin();
        allow create: if isBootstrapAdmin(orgId, emailKey)
          || (
            managesChurch(orgId)
            && isValidMember(orgId, request.resource.data, emailKey)
            && request.resource.data.status == 'invited'
            && request.resource.data.uid == null
            && request.resource.data.role in ['pastor', 'assistant_pastor', 'secretary', 'church_admin']
          );
        allow update: if (
            isAuthenticated()
            && emailKey == emailId()
            && resource.data.uid == null
            && resource.data.email == emailId()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'active'
            && isValidMember(orgId, request.resource.data, emailKey)
            && areImmutableFieldsUnchanged(['email', 'name', 'role', 'pastorId'])
          ) || canRenameOwnProfile(orgId, emailKey);
        allow delete: if false;
      }
    }

    match /directory/{emailKey} {
      allow get: if isAuthenticated() && emailKey == emailId();
      allow list: if false;
      allow create: if canCreateDirectory(emailKey);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
