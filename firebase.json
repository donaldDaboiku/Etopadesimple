{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  },
  "auth": {
    "providers": {
        "googleSignIn": {
          "oAuthBrandDisplayName": "ETOPADE",
          "supportEmail": "donalddaboiku@gmail.com"
        },
        "emailPassword": true
    },
    "authorizedDomains": ["localhost", "etopade.firebaseapp.com", "etopade.web.app"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
